:{$PORT} {
    handle /api/* {
        reverse_proxy {$BACKEND_UPSTREAM} {
            transport http {
                read_timeout 190s
            }
        }
    }

    handle /health {
        reverse_proxy {$BACKEND_UPSTREAM}
    }

    handle /ready {
        reverse_proxy {$BACKEND_UPSTREAM}
    }

    handle {
        root * /srv
        encode zstd gzip
        try_files {path} /index.html
        file_server
    }
}
