:{$PORT} {
    root * /srv
    encode zstd gzip

    handle /api/* {
        reverse_proxy {$BACKEND_UPSTREAM}
    }

    handle /health {
        reverse_proxy {$BACKEND_UPSTREAM}
    }

    @static path /assets/*
    header @static Cache-Control "public, max-age=31536000, immutable"

    @html path /index.html /
    header @html Cache-Control "no-cache, no-store, must-revalidate"

    handle {
        try_files {path} /index.html
        file_server
    }
}
